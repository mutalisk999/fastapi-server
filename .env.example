# Copy this file to `.env` to select an environment, and to `.env.dev` /
# `.env.testing` / `.env.prod` with your real values filled in.

# --- Environment selector (.env) ---
USE_CONFIG=development

# Config password for decrypting secrets (optional; fallback is an interactive
# prompt). Needed for non-interactive environments (systemd, Docker, CI).
# CONFIG_PASS=your_password

# --- .env.dev / .env.testing / .env.prod ---

# JWT configuration (AES-256-GCM encrypted hex string, see README "Encryption")
# JWT_SECRET=<encrypted_hex_string>

# Database configuration
# DATABASE_USER=root
# DATABASE_PASS=<encrypted_hex_string>
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=dev_db
# DATABASE_CHARSET=utf8mb4
# DATABASE_POOL_SIZE=5

# Redis configuration
# REDIS_URL=redis://localhost:6379/0

# CORS configuration
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Server configuration
# SERVER_HOST=0.0.0.0
# SERVER_PORT=7788

# Log configuration
# LOG_FILE_NAME=app.log
# LOG_LEVEL=INFO
# LOG_FILE_SIZE=10485760
# LOG_BACKUP_COUNT=5

# Mock auth (dev/testing only). Production forces this to false.
# MOCK_AUTH_ENABLED=true
